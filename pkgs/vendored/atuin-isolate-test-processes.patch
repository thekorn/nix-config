+        // Integration-test machines must not share the build host's processes.
+        // Normal builds never accept this override.
+        #[cfg(feature = "test-utils")]
+        if let Some(root) = crate::env::var_os("ATUIN_TEST_PROCFS") {
+            return Self::ProcFs(PathBuf::from(root));
+        }
+
         if cfg!(target_os = "linux") {
             Self::ProcFs(PathBuf::from("/proc"))
         } else if sysinfo::IS_SUPPORTED_SYSTEM {
